# Claude Code variant image: installs claude CLI on top of base image.
#
# Claude subscriptions (Pro / Max / Team) do not issue standard API keys, only Claude Code official CLI
# can use subscription credentials, so the `claude_code` provider depends on the claude CLI in container.
FROM ghcr.io/harry0703/moneyprinterturbo:latest

# Pin CLI version to ensure consistent behavior
ARG CLAUDE_CODE_VERSION=2.1.260
ARG NODE_MAJOR=22

# claude CLI is distributed via npm; install Node.js first
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -; \
    apt-get install -y --no-install-recommends nodejs; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    npm cache clean --force; \
    apt-get purge -y gnupg; \
    apt-get autoremove -y; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    claude --version
